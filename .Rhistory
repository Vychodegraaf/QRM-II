#WRITE YOUR CODE HERE
movies <- read.delim("movies4.tsv", header = TRUE)
mean_revenue <- aggregate(revenue ~ release_year,
data = movies,
FUN = mean,
na.rm = TRUE)
plot(mean_revenue$release_year, mean_revenue$revenue,
main = "mean of revenue",
xlab = "Year",
ylab = "Mean Revenue",
pch = 19)
#WRITE YOUR CODE HERE
mean_revenue <- aggregate(revenue ~ release_year,
data = movies,
FUN = mean,
na.rm = TRUE)
sd_revenue <- aggregate(revenue ~ release_year,
data = movies,
FUN = sd,
na.rm = TRUE)
n_revenue <- aggregate(revenue ~ release_year,
data = movies,
FUN = length)
conf_int <- sd_revenue$revenue /sqrt(n_revenue$revenue)
conf_int95 <- 1.96 * conf_int
conf_int_lowerbound <- mean_revenue$revenue - conf_int95
conf_int_upperbound <- mean_revenue$revenue + conf_int95
plot(mean_revenue$release_year, mean_revenue$revenue,
main = "Mean Revenue by Year (95% CI)",
xlab = "Year",
ylab = "Mean Revenue",
pch = 19,
ylim = range(c(conf_int_lowerbound, conf_int_upperbound), na.rm = TRUE))
arrows(x0 = mean_revenue$release_year, y0 = conf_int_lowerbound,
x1 = mean_revenue$release_year, y1 = conf_int_upperbound,
angle = 90, code = 3, length = 0.10)
