#WRITE YOUR CODE HERE
movies <- read.delim("movies4.tsv", header = TRUE)
mean_revenue <- aggregate(revenue ~ release_year,
data = movies,
FUN = mean,
na.rm = TRUE)
plot(mean_revenue$release_year, mean_revenue$revenue/1000000,
main = "mean of revenue",
xlab = "Year",
ylab = "Mean Revenue in millions",
pch = 19)
#WRITE YOUR CODE HERE
mean_revenue <- aggregate(revenue ~ release_year,
data = movies,
FUN = mean,
na.rm = TRUE)
sd_revenue <- aggregate(revenue ~ release_year,
data = movies,
FUN = sd,
na.rm = TRUE)
n_revenue <- aggregate(revenue ~ release_year,
data = movies,
FUN = length)
conf_int <- (sd_revenue$revenue/1000000) /sqrt(n_revenue$revenue)
conf_int95 <- 1.96 * conf_int
conf_int_lowerbound <- mean_revenue$revenue/1000000 - conf_int95
conf_int_upperbound <- mean_revenue$revenue/1000000 + conf_int95
plot(mean_revenue$release_year, mean_revenue$revenue,
main = "Mean Revenue by Year (95% CI)",
xlab = "Year",
ylab = "Mean Revenue In Millions",
pch = 19,
ylim = range(c(conf_int_lowerbound, conf_int_upperbound), na.rm = TRUE))
arrows(x0 = mean_revenue$release_year, y0 = conf_int_lowerbound,
x1 = mean_revenue$release_year, y1 = conf_int_upperbound,
angle = 90, code = 3, length = 0.10)
results <- data.frame(
year = mean_revenue$release_year,
sd = sd_revenue$revenue,
n = n_revenue$revenue,
CI_width = conf_int_upperbound - conf_int_lowerbound
)
highest <- results[order(results$CI_width, decreasing = TRUE), ][1:2, ]
lowest <- results[order(results$CI_width), ][1:2, ]
highest
lowest
